# AquaSentinel AI Environment Configuration
AQUASENTINEL_ENV=development
API_PORT=8000
FRONTEND_PORT=5173
COMPUTE_PROFILE=NORMAL

# Primary ML Datasets
GHOSTVISION_DATA_PATH=./data/GhostVision
